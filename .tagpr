# tagpr configuration. https://github.com/Songmu/tagpr
# Every push to main creates a release PR (bumping version in manifest.json and updating CHANGELOG.md);
# merging it creates the tag and the GitHub Release. The default bump is a patch.
# A tagpr:minor / tagpr:major label on the release PR, or a minor / major label on a PR in the release, changes the bump.
[tagpr]
	vPrefix = false
	releaseBranch = main
	versionFile = manifest.json
	changelog = true
	release = true
